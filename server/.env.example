PORT=8443
DB_PATH=./presence.db
# TLS certificate and key for HTTPS (dev: self-signed). In production, use valid certs or let Nginx handle TLS.
SSL_CERT=./certs/cert.pem
SSL_KEY=./certs/key.pem

# JWT secrets - changez pour votre production
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret

# Symmetric key (32 bytes hex) used to encrypt 2FA secrets using AES-256-GCM
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Discord webhook URL (for absence notifications)
WEBHOOK_URL=https://discord.com/api/webhooks/...

# Discord webhook used to deliver 2FA codes (separate webhook)
DISCORD_2FA_WEBHOOK=https://discord.com/api/webhooks/...

# Threshold after which user is considered absent (minutes)
ABSENCE_MINUTES=10

# Interval to check absences (seconds)
CHECK_INTERVAL_SECONDS=60
