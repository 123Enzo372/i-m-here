PORT=3000

# Supabase: gardez cette clé uniquement côté serveur, jamais dans le client Electron.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
# Alternative si votre projet utilise encore les clés legacy:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT secrets - changez pour votre production
JWT_SECRET=change_this_jwt_secret
ACCESS_TOKEN_TTL=24h
REFRESH_TOKEN_DAYS=30

# Symmetric key (32 bytes hex) used to encrypt 2FA secrets using AES-256-GCM
# Generate: openssl rand -hex 32
TWOFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional legacy/default Discord webhook.
# New users configure their own webhook in the app. Keep this only to backfill old accounts
# or to test the Supabase Edge Function with {"testDiscord": true}.
WEBHOOK_URL=

# Notifications d'inactivité: Discord de J+1 à J+7, mail uniquement au J+7.
INACTIVITY_DAYS=7
INACTIVITY_EMAIL_SUBJECT=Nous avons remarqué votre absence !
INACTIVITY_EMAIL_MESSAGE=Bonjour, cela fait 7 jours que vous ne vous êtes pas connecté à l'application de présence. Tout va bien ?

# SMTP pour le mail du 7e jour
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
