{
  "name": "presence-client",
  "version": "1.1.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.example.presence",
    "productName": "PresenceApp",
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "../server/server.js",
        "to": "server/server.js"
      },
      {
        "from": "../server/package.json",
        "to": "server/package.json"
      },
      {
        "from": "../server/node_modules",
        "to": "server/node_modules",
        "filter": ["**/*"]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "keytar": "^7.9.0",
    "node-fetch": "^2.6.7"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "keytar@7.9.0": true,
    "electron-winstaller@5.4.0": true
  }
}
