{
  "name": "presence-client",
  "version": "1.1.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.example.presence",
    "productName": "PresenceApp",
    "files": [
      "**/*"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    },
    "win": {
      "target": ["nsis"]
    }
  },
  "dependencies": {
    "electron": "^26.0.0",
    "keytar": "^8.1.0",
    "node-fetch": "^2.6.7"
  },
  "devDependencies": {
    "electron-builder": "^24.6.0"
  }
}
