PORT=3000

# Supabase: keep this server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
# Or, for legacy projects:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

JWT_SECRET=change_this_jwt_secret
ACCESS_TOKEN_TTL=24h
REFRESH_TOKEN_DAYS=30

# Generate with: openssl rand -hex 32
TWOFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional fallback for old accounts only. New accounts configure this in the app.
WEBHOOK_URL=

INACTIVITY_DAYS=7
INACTIVITY_EMAIL_SUBJECT=Nous avons remarque votre absence !
INACTIVITY_EMAIL_MESSAGE=Bonjour, cela fait 7 jours que vous ne vous etes pas connecte a l'application de presence. Tout va bien ?

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
